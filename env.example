# Copy this file to .env (it is git-ignored). Never commit real values.
# Supabase > Connect > Transaction pooler string (port 6543). Do not add ?sslmode=...
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
